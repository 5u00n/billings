{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suren-billings",
  "main": "server/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "vars": {
    "BACKEND_URL": ""
  }
}
